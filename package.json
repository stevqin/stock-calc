{
  "name": "t-calculator",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "node scripts/package-mac.mjs",
    "format": "prettier --write src vite.config.ts package.json tsconfig.json index.html",
    "check:format": "prettier --check src vite.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "pinyin-pro": "3.29.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
